# Copy this file to .env.local and fill in every value. NEVER upload .env.local to GitHub.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login ---
# The one password your mother types to open the admin panel. Make it long but easy to type.
ADMIN_PASSWORD=
# A long random text used to sign login cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# Model names change over time. Confirm in Google AI Studio and edit here, no code change needed.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.5-flash

# --- Website address (no slash at the end) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
